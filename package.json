{
  "name": "reviewmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && tsup apps/api/src/index.ts --format esm --platform node --target node24 --out-dir dist/api --sourcemap --external typescript",
    "start": "node --env-file-if-exists=.env dist/api/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "integration": "tsx scripts/integration.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "check:config": "tsx scripts/check-config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@vectorize-io/hindsight-client": "0.10.1",
    "diff": "9.0.0",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "lucide-react": "1.48.0",
    "minimatch": "10.2.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "semver": "7.8.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/diff": "8.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
